// Pantalla principal con la bóveda abierta: barra lateral + sección activa.
// Se adapta al ancho de la ventana según los puntos de corte de `Viewport`.

import { Theme, Icons } from "theme.slint";
import { I18n, Workspace, VaultSection, ItemPanel, Session } from "bridge.slint";
import { BusySpinner, Card, IconButton } from "primitives.slint";
import { Viewport } from "viewport.slint";
import { VaultSidebar } from "sidebar.slint";
import { VaultItemList } from "item_list.slint";
import { VaultItemDetailsPanel, NothingSelectedPanel } from "item_details.slint";
import { VaultItemEditorPanel } from "item_editor.slint";
import { GeneratorPanel } from "generator_panel.slint";
import { PasswordHealthView } from "health_view.slint";
import { SettingsView } from "settings_view.slint";
import { ScrollView } from "std-widgets.slint";

component VerticalDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

/// Panel derecho del espacio de elementos (patrón State: un componente por estado).
component ItemPanelHost inherits Rectangle {
    background: Theme.canvas;
    if Workspace.item-panel == ItemPanel.nothing-selected: NothingSelectedPanel { }
    if Workspace.item-panel == ItemPanel.loading: VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            BusySpinner { }
        }
    }
    if Workspace.item-panel == ItemPanel.details: VaultItemDetailsPanel { }
    if Workspace.item-panel == ItemPanel.editor: VaultItemEditorPanel { }
}

/// Lista y panel lado a lado; en ventanas estrechas, uno a la vez.
/// La lista nunca se destruye: al volver conserva el desplazamiento y la búsqueda.
component ItemsWorkspace inherits Rectangle {
    property <bool> shows-single-pane: Viewport.shows-single-pane;
    property <bool> has-open-item: Workspace.item-panel != ItemPanel.nothing-selected;
    property <length> list-width: shows-single-pane ? root.width : clamp(root.width * 0.26, 260px, 340px);

    VaultItemList {
        x: 0;
        width: root.list-width;
        height: root.height;
        visible: !root.shows-single-pane || !root.has-open-item;
    }
    if !root.shows-single-pane: VerticalDivider {
        x: root.list-width;
        height: root.height;
    }
    ItemPanelHost {
        x: root.shows-single-pane ? 0 : root.list-width + 1px;
        width: root.shows-single-pane ? root.width : root.width - root.list-width - 1px;
        height: root.height;
        visible: !root.shows-single-pane || root.has-open-item;
    }
}

component GeneratorView inherits Rectangle {
    background: Theme.canvas;
    scroll := ScrollView {
        content-width: scroll.visible-width;
        content-height: content.preferred-height;
        content := HorizontalLayout {
            width: scroll.visible-width;
            alignment: center;
            VerticalLayout {
                width: min(576px, scroll.visible-width - Viewport.page-gutter * 2);
                padding-top: 32px;
                padding-bottom: 32px;
                spacing: 20px;
                VerticalLayout {
                    spacing: 4px;
                    Text {
                        text: I18n.t("generator.title");
                        font-size: Theme.font-2xl;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    Text {
                        text: I18n.t("generator.subtitle");
                        color: Theme.text-muted;
                        wrap: word-wrap;
                    }
                }
                Card {
                    GeneratorPanel { }
                }
            }
        }
    }
}

/// Sin barra lateral fija: menú, marca y bloqueo en una barra superior.
component CompactTopBar inherits Rectangle {
    height: 48px;
    background: Theme.canvas;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.menu;
            icon-size: 18px;
            tint: Theme.text;
            label: I18n.t("navigation.openMenu");
            clicked => { Viewport.is-drawer-requested = true; }
        }
        Image {
            y: (parent.height - self.height) / 2;
            width: 24px;
            height: 24px;
            source: Icons.logo;
            accessible-role: none;
        }
        Text {
            horizontal-stretch: 1;
            text: "Arca";
            font-size: Theme.font-lg;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        IconButton {
            y: (parent.height - self.height) / 2;
            icon: Icons.lock;
            label: I18n.t("actions.lock");
            clicked => { Session.lock-now(); }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

/// Barra lateral deslizada sobre el contenido; se cierra al tocar fuera, con Esc o al navegar.
component SidebarDrawer inherits Rectangle {
    background: Theme.overlay;
    TouchArea {
        clicked => { Viewport.is-drawer-requested = false; }
    }
    property <length> drawer-width: min(280px, root.width - 48px);
    // Absorbe los clics sobre el cajón para que no lo cierren; queda debajo de la barra.
    TouchArea {
        x: 0;
        width: root.drawer-width;
    }
    VaultSidebar {
        x: 0;
        width: root.drawer-width;
        height: root.height;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000050;
    }
}

export component VaultScreen inherits Rectangle {
    HorizontalLayout {
        if Viewport.has-fixed-sidebar: VaultSidebar { width: 230px; }
        if Viewport.has-fixed-sidebar: VerticalDivider { }
        VerticalLayout {
            horizontal-stretch: 1;
            if !Viewport.has-fixed-sidebar: CompactTopBar { }
            Rectangle {
                vertical-stretch: 1;
                if Workspace.section == VaultSection.items: ItemsWorkspace { }
                if Workspace.section == VaultSection.generator: GeneratorView { }
                if Workspace.section == VaultSection.health: PasswordHealthView { }
                if Workspace.section == VaultSection.settings: SettingsView { }
            }
        }
    }
    if Viewport.is-drawer-open: SidebarDrawer { }
}
