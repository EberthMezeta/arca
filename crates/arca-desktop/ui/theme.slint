// Tokens de diseño: un único lugar para colores claro/oscuro, radios y tipografía.

export enum ThemeChoice { system, light, dark }

export global Theme {
    // Esquema del sistema: lo da Slint y, en Linux, el portal XDG (al arrancar y en vivo).
    in-out property <bool> system-is-dark;
    in property <ThemeChoice> choice: ThemeChoice.system;
    out property <bool> dark: choice == ThemeChoice.dark || (choice == ThemeChoice.system && system-is-dark);

    out property <color> canvas: dark ? #0f1115 : #f5f6f8;
    out property <color> surface: dark ? #171a20 : #ffffff;
    out property <color> surface-muted: dark ? #1f232b : #eef0f3;
    out property <color> surface-hover: dark ? #262b34 : #e6e9ee;
    out property <color> border: dark ? #2c313b : #dde1e7;
    out property <color> text: dark ? #e8eaee : #15181d;
    out property <color> text-muted: dark ? #9aa3b2 : #5b6472;
    // Acento ámbar, el mismo tono del logo; ambos superan 4.5:1 con su texto (WCAG AA).
    out property <color> accent: dark ? #f59e42 : #b84d0e;
    out property <color> accent-hover: dark ? #fbb46a : #9a3f0a;
    out property <color> accent-soft: dark ? #3a2614 : #fdeadb;
    out property <color> accent-contrast: dark ? #1c130c : #ffffff;
    out property <color> danger: dark ? #f07070 : #d23a3a;
    out property <color> danger-soft: dark ? #3a1c1f : #fde7e7;
    out property <color> success: dark ? #4cc38a : #198754;
    out property <color> success-soft: dark ? #16301f : #def5e8;
    out property <color> warning: dark ? #f0b45a : #b86e00;
    out property <color> warning-soft: dark ? #352713 : #fdf0d9;
    out property <color> overlay: dark ? #000000a0 : #00000060;

    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;
    out property <length> radius-xl: 16px;

    out property <length> font-xs: 11px;
    out property <length> font-sm: 12px;
    out property <length> font-md: 14px;
    out property <length> font-lg: 16px;
    out property <length> font-xl: 19px;
    out property <length> font-2xl: 23px;
    out property <string> monospace-font: "monospace";
}

