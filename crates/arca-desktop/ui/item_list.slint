// Columna central: título del filtro, botón «Nuevo», búsqueda y lista de elementos.

import { Theme, Icons } from "theme.slint";
import { I18n, Workspace, ItemRow, ItemKind, ListState } from "bridge.slint";
import { Button, ButtonVariant, Icon, IconButton, ItemKindBadge, EmptyState, TextField, BusySpinner, VisualRegistry } from "primitives.slint";
import { ListView } from "std-widgets.slint";

component ItemRowView inherits Rectangle {
    in property <ItemRow> item-row;
    in property <int> row-index;
    in property <bool> is-selected;
    callback selected();
    height: 52px;
    border-radius: Theme.radius-md;
    background: is-selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: list-item;
    accessible-label: item-row.title;
    accessible-item-selected: is-selected;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }

        HorizontalLayout {
            padding-left: 10px;
            padding-right: 6px;
            spacing: 12px;
            ItemKindBadge {
                y: (parent.height - self.height) / 2;
                kind: root.item-row.kind;
            }
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.item-row.title;
                        font-size: Theme.font-md;
                        font-weight: 600;
                        color: Theme.text;
                        overflow: elide;
                    }
                    if root.item-row.is-favorite: Icon {
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        source: Icons.star-filled;
                        colorize: Theme.warning;
                        accessible-role: image;
                        accessible-label: I18n.t("fields.favorite");
                    }
                    if root.item-row.has-attachments: Icon {
                        y: (parent.height - self.height) / 2;
                        size: 14px;
                        source: Icons.paperclip;
                    }
                    Rectangle { }
                }
                Text {
                    text: root.item-row.subtitle == "" ? " " : root.item-row.subtitle;
                    font-size: Theme.font-sm;
                    color: Theme.text-muted;
                    overflow: elide;
                }
            }
            if touch.has-hover && root.item-row.can-copy-username: IconButton {
                y: (parent.height - self.height) / 2;
                size: 28px;
                icon-size: 14px;
                icon: Icons.copy;
                label: I18n.t("actions.copyUsername");
                clicked => { Workspace.copy-username(root.row-index); }
            }
            if touch.has-hover && root.item-row.can-copy-password: IconButton {
                y: (parent.height - self.height) / 2;
                size: 28px;
                icon-size: 14px;
                icon: Icons.key-round;
                label: I18n.t("actions.copyPassword");
                clicked => { Workspace.copy-password(root.row-index); }
            }
        }
    }
}

component NewItemMenuEntry inherits Rectangle {
    in property <ItemKind> kind;
    in property <string> label;
    callback chosen();
    height: 36px;
    border-radius: Theme.radius-md;
    background: touch.has-hover ? Theme.surface-hover : transparent;
    accessible-role: button;
    accessible-label: label;
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        spacing: 10px;
        ItemKindBadge {
            y: (parent.height - self.height) / 2;
            size: 28px;
            kind: root.kind;
        }
        Text {
            text: root.label;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

export component VaultItemList inherits Rectangle {
    property <length> row-height: 52px;
    property <int> selected-row: Workspace.selected-row;
    property <int> focus-search-requests: Workspace.focus-search-requests;
    background: Theme.surface;

    /// Flechas arriba/abajo recorren la lista sin soltar el teclado.
    function handle-navigation-key(event: KeyEvent) -> EventResult {
        if event.text == Key.DownArrow {
            Workspace.move-selection(1);
            return accept;
        }
        if event.text == Key.UpArrow {
            Workspace.move-selection(-1);
            return accept;
        }
        return reject;
    }

    changed focus-search-requests => {
        search-field.focus();
        search-field.select-all-text();
    }

    // Mantiene visible la fila seleccionada al moverse con el teclado.
    changed selected-row => {
        if self.selected-row < 0 {
            return;
        }
        if self.selected-row * self.row-height + item-list.content-y < 0 {
            item-list.content-y = -self.selected-row * self.row-height;
        } else if (self.selected-row + 1) * self.row-height + item-list.content-y > item-list.visible-height {
            item-list.content-y = item-list.visible-height - (self.selected-row + 1) * self.row-height;
        }
    }

    VerticalLayout {
        VerticalLayout {
            padding: 12px;
            spacing: 12px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    horizontal-stretch: 1;
                    text: Workspace.list-title;
                    font-size: Theme.font-lg;
                    font-weight: 700;
                    color: Theme.text;
                    vertical-alignment: center;
                    overflow: elide;
                }
                new-button := Button {
                    label: I18n.t("actions.new");
                    variant: ButtonVariant.primary;
                    has-icon: true;
                    icon: Icons.plus;
                    clicked => { new-item-menu.show(); }
                }
            }
            Rectangle {
                height: 36px;
                search-field := TextField {
                    width: 100%;
                    text <=> Workspace.search-text;
                    placeholder: I18n.t("search.placeholder");
                    accessible-name: I18n.t("search.label");
                    edited(text) => { Workspace.search-edited(text); }
                    key-pressed(event) => { return root.handle-navigation-key(event); }
                }
            }
        }
        Rectangle {
            height: 1px;
            background: Theme.border;
        }

        Rectangle {
            vertical-stretch: 1;
            if Workspace.list-state == ListState.loading: VerticalLayout {
                alignment: start;
                padding: 32px;
                HorizontalLayout {
                    alignment: center;
                    BusySpinner { }
                }
            }
            if Workspace.list-state == ListState.vault-empty: EmptyState {
                icon: Icons.shield-check;
                headline: I18n.t("emptyStates.vaultEmptyTitle");
                explanation: I18n.t("emptyStates.vaultEmptyText");
                Button {
                    label: I18n.t("emptyStates.addFirstLogin");
                    variant: ButtonVariant.primary;
                    has-icon: true;
                    icon: Icons.key-round;
                    clicked => { Workspace.create-item(ItemKind.login); }
                }
                Button {
                    label: I18n.t("emptyStates.importFromBitwarden");
                    has-icon: true;
                    icon: Icons.upload;
                    clicked => { Workspace.request-import(); }
                }
            }
            if Workspace.list-state == ListState.no-matches: EmptyState {
                icon: Workspace.no-matches-is-trash ? Icons.trash : Icons.search;
                headline: Workspace.no-matches-headline;
                explanation: Workspace.no-matches-text;
            }
            list-focus := FocusScope {
                visible: Workspace.list-state == ListState.item-list;
                key-pressed(event) => {
                    return root.handle-navigation-key(event);
                }
                item-list := ListView {
                    for row[row-index] in Workspace.item-rows: VerticalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        ItemRowView {
                            item-row: row;
                            row-index: row-index;
                            is-selected: row-index == Workspace.selected-row;
                            selected => {
                                Workspace.select-row(row-index);
                                list-focus.focus();
                            }
                        }
                    }
                }
            }
        }

        if Workspace.item-rows.length > 0: VerticalLayout {
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            Text {
                height: 32px;
                x: 16px;
                text: Workspace.result-count;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                vertical-alignment: center;
            }
        }
    }

    new-item-menu := PopupWindow {
        x: root.width - 220px - 12px;
        y: 56px;
        width: 220px;
        Rectangle {
            background: Theme.surface;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000030;
            VerticalLayout {
                padding: 4px;
                for kind-entry in [
                    { kind: ItemKind.login, key: "itemTypes.login" },
                    { kind: ItemKind.secure-note, key: "itemTypes.secureNote" },
                    { kind: ItemKind.payment-card, key: "itemTypes.paymentCard" },
                    { kind: ItemKind.identity, key: "itemTypes.identity" },
                ]: NewItemMenuEntry {
                    kind: kind-entry.kind;
                    label: I18n.t(kind-entry.key);
                    chosen => {
                        new-item-menu.close();
                        Workspace.create-item(kind-entry.kind);
                    }
                }
            }
        }
    }
}
