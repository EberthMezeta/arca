// Panel derecho en modo lectura: secretos enmascarados que se revelan o copian bajo demanda.

import { Theme, Icons } from "theme.slint";
import { I18n, ItemDetails, DetailRow, DetailRowKind, AttachmentRow } from "bridge.slint";
import { Button, ButtonVariant, Icon, IconButton, ItemKindBadge, SectionLabel, LinkButton, EmptyState } from "primitives.slint";
import { ScrollView } from "std-widgets.slint";

component DetailRowView inherits Rectangle {
    in property <DetailRow> detail-row;
    property <bool> is-secret: detail-row.kind == DetailRowKind.secret;
    property <bool> is-totp: detail-row.kind == DetailRowKind.totp;
    property <bool> is-about-to-expire: is-totp && ItemDetails.totp-seconds-left <= 5;
    min-height: 54px;

    touch := TouchArea {
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            VerticalLayout {
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.detail-row.label;
                    font-size: Theme.font-sm;
                    color: Theme.text-muted;
                    overflow: elide;
                }
                if !root.is-totp: Text {
                    text: root.detail-row.value;
                    font-size: Theme.font-md;
                    font-family: root.is-secret ? Theme.monospace-font : "";
                    color: Theme.text;
                    overflow: elide;
                }
                if root.is-totp: HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: ItemDetails.totp-code;
                        font-size: Theme.font-lg;
                        font-weight: 700;
                        font-family: Theme.monospace-font;
                        letter-spacing: 2px;
                        color: root.is-about-to-expire ? Theme.danger : Theme.accent;
                        vertical-alignment: center;
                    }
                    // Barra que se vacía hasta el próximo código.
                    Rectangle {
                        y: (parent.height - self.height) / 2;
                        width: 44px;
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.surface-hover;
                        accessible-role: progress-indicator;
                        accessible-label: I18n.with("totp.secondsLeft", "secondsLeft", ItemDetails.totp-seconds-left);
                        Rectangle {
                            x: 0;
                            width: parent.width * ItemDetails.totp-seconds-left / max(1, ItemDetails.totp-period-seconds);
                            height: 100%;
                            border-radius: 2px;
                            background: root.is-about-to-expire ? Theme.danger : Theme.accent;
                            animate width { duration: 1s; easing: linear; }
                        }
                    }
                    Text {
                        text: ItemDetails.totp-seconds-left + "s";
                        font-size: Theme.font-sm;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                    Rectangle { }
                }
            }
            HorizontalLayout {
                opacity: touch.has-hover ? 1 : 0.7;
                spacing: 2px;
                if root.is-secret: IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: root.detail-row.is-revealed ? Icons.eye-off : Icons.eye;
                    label: I18n.t(root.detail-row.is-revealed ? "actions.hide" : "actions.show");
                    clicked => { ItemDetails.toggle-reveal(root.detail-row.row-index); }
                }
                IconButton {
                    y: (parent.height - self.height) / 2;
                    icon: Icons.copy;
                    label: I18n.t("actions.copy");
                    clicked => { ItemDetails.copy-row(root.detail-row.row-index); }
                }
            }
        }
    }
}

component DetailSection inherits VerticalLayout {
    in property <string> title;
    spacing: 6px;
    if root.title != "": SectionLabel {
        x: 4px;
        text: root.title;
    }
    Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            @children
        }
    }
}

component RowSeparator inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

/// Texto multilínea seleccionable (notas).
component SelectableNotes inherits VerticalLayout {
    in property <string> notes;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 12px;
    padding-bottom: 12px;
    TextInput {
        text: root.notes;
        read-only: true;
        wrap: word-wrap;
        single-line: false;
        color: Theme.text;
        font-size: Theme.font-md;
        selection-background-color: Theme.accent-soft;
    }
}

component DetailsHeader inherits Rectangle {
    background: Theme.surface;
    height: 76px;
    HorizontalLayout {
        padding-left: 24px;
        padding-right: 24px;
        spacing: 12px;
        ItemKindBadge {
            y: (parent.height - self.height) / 2;
            size: 44px;
            kind: ItemDetails.kind;
        }
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: ItemDetails.title;
                font-size: Theme.font-xl;
                font-weight: 700;
                color: Theme.text;
                overflow: elide;
            }
            Text {
                text: ItemDetails.kind-label;
                font-size: Theme.font-sm;
                color: Theme.text-muted;
            }
        }
        if ItemDetails.is-in-trash: HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Button {
                y: (parent.height - self.height) / 2;
                label: I18n.t("actions.restore");
                has-icon: true;
                icon: Icons.rotate-ccw;
                clicked => { ItemDetails.restore(); }
            }
            Button {
                y: (parent.height - self.height) / 2;
                label: I18n.t("actions.deleteForever");
                variant: ButtonVariant.danger;
                has-icon: true;
                icon: Icons.trash;
                clicked => { ItemDetails.delete-forever(); }
            }
        }
        if !ItemDetails.is-in-trash: HorizontalLayout {
            spacing: 6px;
            alignment: end;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: ItemDetails.is-favorite ? Icons.star-filled : Icons.star;
                tint: ItemDetails.is-favorite ? Theme.warning : Theme.text-muted;
                label: I18n.t(ItemDetails.is-favorite ? "actions.unfavorite" : "actions.favorite");
                clicked => { ItemDetails.toggle-favorite(); }
            }
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: Icons.trash;
                label: I18n.t("actions.moveToTrash");
                clicked => { ItemDetails.move-to-trash(); }
            }
            Button {
                y: (parent.height - self.height) / 2;
                label: I18n.t("actions.edit");
                variant: ButtonVariant.primary;
                has-icon: true;
                icon: Icons.pencil;
                clicked => { ItemDetails.edit(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

component AttachmentsSection inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        padding-left: 4px;
        padding-right: 4px;
        SectionLabel {
            text: I18n.t("attachments.title");
            vertical-alignment: center;
        }
        Rectangle { }
        if !ItemDetails.is-in-trash: LinkButton {
            label: I18n.t("attachments.add");
            icon: Icons.paperclip;
            enabled: !ItemDetails.is-adding-attachment;
            clicked => { ItemDetails.add-attachment(); }
        }
    }
    if ItemDetails.attachments.length == 0: Rectangle {
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        VerticalLayout {
            padding: 12px;
            padding-left: 16px;
            Text {
                text: I18n.t("attachments.none");
                font-size: Theme.font-sm;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
    if ItemDetails.attachments.length > 0: Rectangle {
        background: Theme.surface;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;
        VerticalLayout {
            for attachment[attachment-index] in ItemDetails.attachments: VerticalLayout {
                if attachment-index > 0: RowSeparator { }
                HorizontalLayout {
                    height: 52px;
                    padding-left: 16px;
                    padding-right: 12px;
                    spacing: 12px;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        source: Icons.paperclip;
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: attachment.file-name;
                            color: Theme.text;
                            overflow: elide;
                        }
                        Text {
                            text: attachment.size-text;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                        }
                    }
                    IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.download;
                        label: I18n.t("attachments.saveCopy");
                        clicked => { ItemDetails.save-attachment(attachment-index); }
                    }
                    if !ItemDetails.is-in-trash: IconButton {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.close;
                        label: I18n.t("actions.remove");
                        clicked => { ItemDetails.delete-attachment(attachment-index); }
                    }
                }
            }
        }
    }
}

export component VaultItemDetailsPanel inherits Rectangle {
    background: Theme.canvas;
    VerticalLayout {
        DetailsHeader { }
        scroll := ScrollView {
            vertical-stretch: 1;
            content-width: scroll.visible-width;
            content-height: content.preferred-height;
            content := HorizontalLayout {
                width: scroll.visible-width;
                alignment: center;
                VerticalLayout {
                    width: min(672px, scroll.visible-width - 48px);
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 20px;
                    if ItemDetails.main-rows.length > 0 || (ItemDetails.notes-in-main-section && ItemDetails.notes != ""): DetailSection {
                        for detail-row[position] in ItemDetails.main-rows: VerticalLayout {
                            if position > 0: RowSeparator { }
                            DetailRowView { detail-row: detail-row; }
                        }
                        if ItemDetails.notes-in-main-section && ItemDetails.notes != "": SelectableNotes {
                            notes: ItemDetails.notes;
                        }
                    }
                    if ItemDetails.custom-rows.length > 0: DetailSection {
                        title: I18n.t("editor.customFields");
                        for detail-row[position] in ItemDetails.custom-rows: VerticalLayout {
                            if position > 0: RowSeparator { }
                            DetailRowView { detail-row: detail-row; }
                        }
                    }
                    if !ItemDetails.notes-in-main-section && ItemDetails.notes != "": DetailSection {
                        title: I18n.t("fields.notes");
                        SelectableNotes { notes: ItemDetails.notes; }
                    }
                    if ItemDetails.attachments.length > 0 || !ItemDetails.is-in-trash: AttachmentsSection { }
                    VerticalLayout {
                        padding-left: 4px;
                        spacing: 4px;
                        if ItemDetails.tag-names.length > 0: HorizontalLayout {
                            spacing: 6px;
                            padding-bottom: 8px;
                            alignment: start;
                            for tag-name in ItemDetails.tag-names: Rectangle {
                                height: 22px;
                                width: tag-text.preferred-width + 16px;
                                border-radius: 11px;
                                background: Theme.surface-muted;
                                tag-text := Text {
                                    text: "#" + tag-name;
                                    font-size: Theme.font-sm;
                                    font-weight: 600;
                                    color: Theme.text;
                                }
                            }
                        }
                        Text {
                            text: ItemDetails.updated-text;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                        }
                        Text {
                            text: ItemDetails.created-text;
                            font-size: Theme.font-sm;
                            color: Theme.text-muted;
                        }
                        if ItemDetails.history-text != "": HorizontalLayout {
                            spacing: 4px;
                            alignment: start;
                            Icon {
                                size: 14px;
                                source: Icons.history;
                            }
                            Text {
                                text: ItemDetails.history-text;
                                font-size: Theme.font-sm;
                                color: Theme.text-muted;
                            }
                        }
                    }
                }
            }
        }
    }
}

export component NothingSelectedPanel inherits Rectangle {
    background: Theme.canvas;
    EmptyState {
        icon: Icons.pointer;
        headline: I18n.t("emptyStates.nothingSelectedTitle");
        explanation: I18n.t("emptyStates.nothingSelectedText");
    }
}
