    in-out property <string> confirmed-master-password;
    in property <string> master-password-error;
    in property <bool> is-changing-master-password;
    callback change-master-password();

    in property <[string]> import-format-names;
    in-out property <int> import-format-index;
    in property <string> import-hint;
    in property <bool> import-requires-password;
    in-out property <string> import-file-password;
    in property <bool> is-importing;
    callback import-format-selected(index: int);
