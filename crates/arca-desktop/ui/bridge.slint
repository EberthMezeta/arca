    in property <[string]> language-names;
    in-out property <int> language-index;
    in property <[string]> theme-names;
    in-out property <int> theme-index;
    callback language-selected(index: int);
    callback theme-selected(index: int);

    in property <bool> preferences-loaded;
    in property <[string]> auto-lock-labels;
    in-out property <int> auto-lock-index;
    in property <[string]> clipboard-clear-labels;
    in-out property <int> clipboard-clear-index;
    in property <[string]> history-limit-labels;
    in-out property <int> history-limit-index;
    in-out property <bool> locks-on-minimize;
    callback preferences-changed();

    in-out property <string> current-master-password;
