    icon: NavIcon,
    shortcut: string,
}

export global CommandPalette {
    in property <bool> is-open;
    in-out property <string> query;
    in property <[PaletteEntry]> entries;
    in-out property <int> highlighted;
    callback query-edited(query: string);
    callback execute(entry: int);
    callback close();
}
