    in property <[string]> export-format-names;
    in-out property <int> export-format-index;
    in property <bool> export-requires-password;
    in property <bool> export-is-plaintext;
    in-out property <string> export-file-password;
    in-out property <string> export-confirmed-password;
    in-out property <string> export-master-password;
    in-out property <bool> plaintext-risk-acknowledged;
    in property <bool> is-exporting;
